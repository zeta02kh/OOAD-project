<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<TabPane xmlns="http://javafx.com/javafx/11.0.1"
         xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="bank.system.bankingsystem.BankingController">

    <tabs>
        <Tab text="Customer Management">
            <content>
                <VBox spacing="10.0">
                    <children>
                        <Label text="Customer Management" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                        <HBox spacing="10.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#showCreateCustomer" text="Create Customer" />
                                <Button mnemonicParsing="false" onAction="#showFindCustomer" text="Find Customer" />
                            </children>
                        </HBox>
                        <Label text="Customer Information:"/>
                        <TextArea fx:id="customerInfoArea" editable="false" prefHeight="300.0" prefWidth="900.0" />
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </VBox>
            </content>
        </Tab>

        <Tab text="Account Management">
            <content>
                <VBox spacing="10.0">
                    <children>
                        <Label text="Account Management" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                        <HBox spacing="10.0">
                            <children>
                                <TextField fx:id="customerIdField" promptText="Customer ID" prefWidth="220"/>
                                <Button mnemonicParsing="false" onAction="#showOpenAccount" text="Open Account" />
                                <Button mnemonicParsing="false" onAction="#showCustomerAccounts" text="View Accounts" />
                            </children>
                        </HBox>
                        <Label text="Customer Accounts:"/>
                        <ListView fx:id="accountsListView" prefHeight="300.0" prefWidth="900.0" />
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </VBox>
            </content>
        </Tab>

        <Tab text="Transactions">
            <content>
                <VBox spacing="10.0">
                    <children>
                        <Label text="Transactions" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                        <HBox spacing="10.0">
                            <children>
                                <TextField fx:id="accountNumberField" promptText="Account Number" prefWidth="220"/>
                                <TextField fx:id="amountField" promptText="Amount" prefWidth="120"/>
                                <Button mnemonicParsing="false" onAction="#handleDeposit" text="Deposit" />
                                <Button mnemonicParsing="false" onAction="#handleWithdraw" text="Withdraw" />
                                <Button mnemonicParsing="false" onAction="#calculateAllInterest" text="Calculate Interest" />
                            </children>
                        </HBox>
                        <Label text="Transaction Results:"/>
                        <TextArea fx:id="transactionInfoArea" editable="false" prefHeight="250.0" prefWidth="900.0" />
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </VBox>
            </content>
        </Tab>
    </tabs>
</TabPane>
